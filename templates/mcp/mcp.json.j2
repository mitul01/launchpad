{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ mcp_github_token }}"
      }
    },
    "jira": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-jira"
      ],
      "env": {
        "JIRA_HOST": "{{ mcp_jira_host }}",
        "JIRA_EMAIL": "{{ mcp_jira_email }}",
        "JIRA_API_TOKEN": "{{ mcp_jira_api_token }}"
      }
    },
    "confluence": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-confluence"
      ],
      "env": {
        "CONFLUENCE_HOST": "{{ mcp_confluence_host }}",
        "CONFLUENCE_EMAIL": "{{ mcp_confluence_email }}",
        "CONFLUENCE_API_TOKEN": "{{ mcp_confluence_api_token }}"
      }
    },
    "datadog": {
      "command": "npx",
      "args": [
        "-y",
        "@datadog/mcp-server-datadog"
      ],
      "env": {
        "DATADOG_API_KEY": "{{ mcp_datadog_api_key }}",
        "DATADOG_APP_KEY": "{{ mcp_datadog_app_key }}",
        "DATADOG_SITE": "{{ mcp_datadog_site }}"
      }
    },
    "steampipe": {
      "command": "npx",
      "args": [
        "-y",
        "@turbot/steampipe-mcp"
      ]
    }
  }
}
